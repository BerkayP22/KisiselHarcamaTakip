@model IslemDuzenleViewModel
@{
    ViewData["Title"] = "İşlemi düzenle";
}

<h1>İşlemi düzenle</h1>

<div class="row">
    <div class="col-md-7 col-lg-6">
        <div class="kht-form-card">
            <form asp-action="Edit" method="post" novalidate>
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Tur" class="form-label"></label>
                    <select asp-for="Tur" asp-items="Model.IslemTurleri" class="form-select"></select>
                    <span asp-validation-for="Tur" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Aciklama" class="form-label"></label>
                    <input asp-for="Aciklama" class="form-control" />
                    <span asp-validation-for="Aciklama" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Tutar" class="form-label"></label>
                    <input id="Tutar" name="Tutar" value="@(ViewData.ModelState["Tutar"]?.AttemptedValue ?? Model.Tutar.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="form-control" type="text" inputmode="decimal" placeholder="Örn. 1.250,50" autocomplete="off" />
                    <span asp-validation-for="Tutar" class="text-danger"></span>
                    <div class="form-text">Virgül veya nokta ile ondalık girebilirsiniz.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Tarih" class="form-label"></label>
                    <input asp-for="Tarih" class="form-control" />
                    <span asp-validation-for="Tarih" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="KategoriId" class="form-label"></label>
                    <select asp-for="KategoriId" asp-items="Model.Kategoriler" class="form-select">
                        <option value="">Kategori yok</option>
                    </select>
                    <span asp-validation-for="KategoriId" class="text-danger"></span>
                    <div class="form-text">Gider kaydında kategori seçilmesi gerekir.</div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Değişiklikleri kaydet</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
